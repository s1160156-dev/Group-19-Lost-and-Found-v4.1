# Copy this file to .env. Never share .env or put it in the web folder.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Keep true to reject non-free model IDs. Availability/quotas depend on provider.
FREE_ONLY=true
PORT=8765
# Local only. Do not change to 0.0.0.0 for public hosting without adding security.
HOST=127.0.0.1
